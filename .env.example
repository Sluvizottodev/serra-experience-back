NODE_ENV=development
PORT=3333

# Database
DATABASE_URL=postgresql://user:password@host:5432/viagem_motorista?schema=public

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# CORS
CORS_ORIGIN=http://localhost:5173

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Resend (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MAIL_FROM=Serra Experience <noreply@seudominio.com>

# Upstash QStash (https://upstash.com) — fila de notificações com retry automático.
# Opcional: se vazio, e-mails de notificação são enviados de forma síncrona (sem fila).
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# URL pública deste backend, necessária só quando QSTASH_TOKEN estiver definido.
BACKEND_PUBLIC_URL=https://api.seudominio.com.br

# PicPay
PICPAY_TOKEN=your_picpay_token
PICPAY_SELLER_TOKEN=your_seller_token
PICPAY_API_URL=https://appws.picpay.com/ecommerce/public/v2

# Criptografia de dados sensíveis (CPF)
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CPF_ENCRYPTION_KEY=your_64_char_hex_key_here
